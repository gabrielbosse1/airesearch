checkpoints/
final_model/
final_model_fp16.pt
phone_model_fp16.zip
phone_export/

# Phase 21 forensic replay checkpoints are regenerated by debug.replay_training.
# The JSON/Markdown/PNG evidence in runs/phase21/ is kept under version control.
runs/phase21/checkpoints/
runs/phase21/replay/*.pt

# Phase 22: large training artefacts (checkpoints, streamed shards, telemetry)
runs/phase22/checkpoints/
runs/phase22/*.pt
